{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "echo \"hook fired: $(date)\" >> /tmp/copilot-hook-test.log",
        "powershell": "Add-Content -Path \"$env:TEMP\\copilot-hook-test.log\" -Value \"hook fired: $(Get-Date)\"",
        "timeoutSec": 10
      }
    ]
  }
}
